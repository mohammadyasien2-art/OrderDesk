services:
  db:
    image: postgres:15
    container_name: orderdesk-db
    environment:
      POSTGRES_USER: orderdesk
      POSTGRES_PASSWORD: orderdesk
      POSTGRES_DB: orderdesk
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - orderdesk-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U orderdesk"]
      interval: 5s
      retries: 10
    restart: unless-stopped

  app:
    image: mohammadyasien2/orderdesk:0.1.0
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/orderdesk
      SPRING_DATASOURCE_USERNAME: orderdesk
      SPRING_DATASOURCE_PASSWORD: orderdesk
    depends_on:
      db:
        condition: service_healthy
    networks:
      - orderdesk-net
    restart: unless-stopped

  nginx:
    image: nginx:alpine
    container_name: orderdesk-nginx
    ports:
      - "80:80"   
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - app
    networks:
      - orderdesk-net
    restart: unless-stopped

volumes:
  pgdata:

networks:
  orderdesk-net:
